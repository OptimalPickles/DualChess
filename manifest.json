{
    "name": "Performance",
    "description" : "To accurately compare to chess.com users for current skill level",
    "version": "1.0",
    "manifest_version": 3,
    "action": {
        "default_popup": "popup/main.html",
        "default_icon": {
            "16": "icons/rook-16.png",
            "32": "icons/rook-32.png",
            "48": "icons/rook-48.png",
            "128": "icons/rook-128.png"
        }
    },
    "icons": {
        "16": "icons/rook-16.png",
        "32": "icons/rook-32.png",
        "48": "icons/rook-48.png",
        "128": "icons/rook-128.png"
    },
    "permissions": ["activeTab", "scripting", "storage"],
    "host_permissions": ["https://www.chess.com/*", "https://api.chess.com/*"]
}
